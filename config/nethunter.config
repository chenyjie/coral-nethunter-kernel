# --- KernelSU hook method: manual hook (match device) ---
# 2026-09-24 更正：此前"必须显式关掉 KSU_SUSFS"的判断是错的。
# 树里 su 接管那些钩子（fs/exec.c, fs/open.c 的 ksu_handle_execveat 等）
# 全被 #ifdef CONFIG_KSU_SUSFS 包着；关掉 SUSFS = 钩子被条件编译掉 = su 永远拿不到 root。
# 那三个 hook 方式（KernelSU/kernel/Kconfig 的 choice 块）是真正的三选一、互斥：
#   KSU_TRACEPOINT_HOOK / KSU_MANUAL_HOOK / KSU_SUSFS
# 自我更正：先前写的"KSU_SUSFS depends on KSU_MANUAL_HOOK"是错的（那其实是同一 choice 内的互斥关系）。
# 树里 su 接管那些钩子全部写在 #ifdef CONFIG_KSU_SUSFS 下，所以 SUSFS 才是这棵树原生支持的钩法：
# defconfig 自带 CONFIG_KSU_SUSFS=y，保持开启：
# -KSU_SUSFS
KSU_MANUAL_HOOK
KSU_MANUAL_HOOK_AUTO_SETUID_HOOK
KSU_MANUAL_HOOK_AUTO_INITRC_HOOK
KSU_MANUAL_HOOK_AUTO_INPUT_HOOK

# --- DIAG PROBES (temp 2026-09-23): turn boot hangs into panics so pstore captures the log ---
PANIC_ON_OOPS
DETECT_HUNG_TASK
BOOTPARAM_HUNG_TASK_PANIC
LOCKUP_DETECTOR
SOFTLOCKUP_DETECTOR
BOOTPARAM_SOFTLOCKUP_PANIC
HARDLOCKUP_DETECTOR
BOOTPARAM_HARDLOCKUP_PANIC
RCU_PANIC_ON_STALL=1
WQ_WATCHDOG

# --- DIAG: plaintext panic logger + stricter probes ---
KPANIC_LOGGER
DEFAULT_HUNG_TASK_TIMEOUT=30

# built-in WLAN: eliminate the vendor module CRC mismatch
QCA_CLD_WLAN=y

# --- CFI (2026-09-28): 保留 LTO/CFI 机制，但让 CFI 校验失败只告警、不 panic ---
# aircrack 8812au 驱动（CONFIG_88XXAU，内建）不是 CFI-clean；插卡时其内部
# 间接调用触发 CFI failure。当前 enforcing 模式下 handle_cfi_failure 直接 panic
# → 只要插着卡就 bootloop。CFI_PERMISSIVE 把这组失败降级成 WARN_RATELIMIT，
# 间接调用照常执行到目标函数，网卡功能不受影响。
CFI_PERMISSIVE
